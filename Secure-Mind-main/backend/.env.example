# API Gateway / Lambda Settings
REGION=us-east-1

# External AI Provider: NVIDIA (Preferred provider)
MODEL_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-xxxxxx
NVIDIA_MODEL=meta/llama3-8b-instruct

# AWS Infrastructure (for local testing — in Lambda, IAM role is used automatically)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# Source Code & Identity
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your_secret_here