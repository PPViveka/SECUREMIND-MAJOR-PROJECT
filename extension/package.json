{
  "name": "sage-armor-scanner",
  "displayName": "Sage Armor Security Scanner",
  "description": "Real-time security vulnerability scanning with differential verification and verified patch generation in VS Code powered by SageArmor (Amazon Bedrock / Local Fallback)",
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Security",
    "Linters"
  ],
  "keywords": [
    "security",
    "vulnerability",
    "scanner",
    "siem",
    "code-analysis"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrey-ran/Sage-Armor-hack.git"
  },
  "license": "MIT",
  "author": "Sage Armor Team",
  "publisher": "sage-armor",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:java",
    "onLanguage:go",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:csharp",
    "onLanguage:ruby",
    "onLanguage:php",
    "onLanguage:swift",
    "onLanguage:kotlin",
    "onLanguage:rust",
    "onLanguage:sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sageArmor.scanFile",
        "title": "Sage Armor: Scan Current File"
      },
      {
        "command": "sageArmor.scanWorkspace",
        "title": "Sage Armor: Scan Workspace"
      },
      {
        "command": "sageArmor.openSettings",
        "title": "Sage Armor: Settings"
      },
      {
        "command": "sageArmor.openAdvancedSettings",
        "title": "Sage Armor: Advanced Settings"
      },
      {
        "command": "sageArmor.testConnection",
        "title": "Sage Armor: Test Backend Connection"
      },
      {
        "command": "sageArmor.rescanActiveFile",
        "title": "Sage Armor: Rescan Active File"
      },
      {
        "command": "sageArmor.previewFix",
        "title": "Sage Armor: Preview Fix"
      },
      {
        "command": "sageArmor.attackPath",
        "title": "Sage Armor: Generate Attack Path Graph"
      },
      {
        "command": "sageArmor.riskScore",
        "title": "Sage Armor: View Risk Rankings"
      },
      {
        "command": "sageArmor.copilotChat",
        "title": "Sage Armor: Ask Security Copilot"
      },
      {
        "command": "sageArmor.repoScan",
        "title": "Sage Armor: Start Repository Scan"
      },
      {
        "command": "sageArmor.repoAutofix",
        "title": "Sage Armor: Start Repository Autofix"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sageArmor.scanFile",
          "when": "editorLangId == python || editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact || editorLangId == java || editorLangId == go || editorLangId == cpp || editorLangId == c || editorLangId == csharp || editorLangId == ruby || editorLangId == php || editorLangId == swift || editorLangId == kotlin || editorLangId == rust || editorLangId == sql",
          "group": "sageArmor@1"
        }
      ],
      "explorer/context": [
        {
          "command": "sageArmor.scanWorkspace",
          "when": "workspaceFolderCount > 0",
          "group": "sageArmor@1"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "sageArmorPanel",
          "name": "Sage Armor",
          "icon": "$(shield)",
          "contextualTitle": "Security Scanner"
        }
      ]
    },
    "configuration": {
      "title": "Sage Armor",
      "properties": {
        "sageArmor.backendUrl": {
          "type": "string",
          "default": "http://localhost:6060",
          "description": "Backend API URL"
        },
        "sageArmor.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Scan file automatically on save"
        },
        "sageArmor.scanOnKeystroke": {
          "type": "boolean",
          "default": false,
          "description": "Scan file on every keystroke (aggressive)"
        },
        "sageArmor.severityFilter": {
          "type": "array",
          "default": [
            "Critical",
            "High",
            "Medium"
          ],
          "description": "Show vulnerabilities of selected severity levels"
        },
        "sageArmor.supportedLanguages": {
          "type": "array",
          "default": [
            "python",
            "javascript",
            "typescript",
            "java",
            "go",
            "cpp",
            "c",
            "csharp",
            "ruby",
            "php",
            "swift",
            "kotlin",
            "rust",
            "sql"
          ],
          "description": "File types to scan"
        },
        "sageArmor.scanMode": {
          "type": "string",
          "enum": ["rules-only", "balanced", "thorough"],
          "default": "balanced",
          "description": "Analysis mode used for file scans"
        },
        "sageArmor.dailyBudget": {
          "type": "number",
          "minimum": 0,
          "default": 100,
          "description": "Maximum model-assisted scans per day"
        },
        "sageArmor.provider": {
          "type": "string",
          "enum": ["Amazon Bedrock", "OpenAI", "Anthropic", "Local Rules Only"],
          "default": "Amazon Bedrock",
          "description": "Configured LLM and verification provider"
        },
        "sageArmor.sandboxPolicy": {
          "type": "string",
          "enum": ["subprocess", "docker", "mock", "strict"],
          "default": "subprocess",
          "description": "Sandbox isolation policy for exploit verification"
        },
        "sageArmor.showRefuted": {
          "type": "boolean",
          "default": false,
          "description": "Display refuted findings in diagnostics and sidebar"
        },
        "sageArmor.privacyNotice": {
          "type": "string",
          "default": "Code is sent to configured backend URL. Local fallback or API key depends on provider configuration.",
          "description": "Privacy notice for code scanning"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs",
    "esbuild": "npm run esbuild-base -- --sourcemap",
    "esbuild-testables": "esbuild ./src/testable.ts --bundle --outfile=out/testable.js --platform=node --format=cjs --sourcemap",
    "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
    "compile": "npm run esbuild",
    "compile:testables": "npm run esbuild-testables",
    "watch": "npm run esbuild-watch",
    "pretest": "npm run compile && npm run compile:testables",
    "test": "node --test tests/**/*.test.cjs",
    "lint": "eslint src --ext ts",
    "package": "npm test && vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^18.18.0",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.50.0",
    "typescript": "~5.3.3",
    "vsce": "^2.15.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
