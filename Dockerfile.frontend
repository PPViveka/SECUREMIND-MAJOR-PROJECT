# syntax=docker/dockerfile:1
# -----------------------------------------------------------------------------
# Stage 1: Build Frontend Assets
# -----------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
# The dashboard calls the backend through nginx's /api/ proxy (same origin).
ENV VITE_API_BASE_URL=/api
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2: Production Nginx Server
# -----------------------------------------------------------------------------
FROM nginx:alpine AS runner

COPY --from=builder /app/dist /usr/share/nginx/html

# nginx:alpine runs envsubst on /etc/nginx/templates/*.template at start-up, so
# ${SAGEARMOR_AUTH_TOKEN} is read from the container environment (never baked into
# the image or the browser bundle) and added to every proxied /api/ request.
RUN mkdir -p /etc/nginx/templates && rm -f /etc/nginx/conf.d/default.conf && printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    location / {\n\
        root /usr/share/nginx/html;\n\
        index index.html;\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location /api/ {\n\
        proxy_pass http://backend:6060/;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-SageArmor-Token ${SAGEARMOR_AUTH_TOKEN};\n\
        proxy_buffering off;\n\
    }\n\
}\n' > /etc/nginx/templates/default.conf.template

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
